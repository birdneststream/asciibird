{
  "name": "asciibird",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:complexity": "eslint src/ --rule 'complexity: warn' --rule 'max-depth: warn' --rule 'max-lines-per-function: warn' --rule 'max-lines: warn'",
    "knip": "knip",
    "stats": "vite build && echo 'Open dist/stats.html for bundle analysis'"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@headlessui/vue": "^1.7",
    "@tailwindcss/forms": "^0.5.7",
    "@vueuse/core": "^14",
    "autoprefixer": "^10.4.19",
    "hotkeys-js": "^3.13.7",
    "idb-keyval": "^6.2.2",
    "lz-string": "^1.4.4",
    "material-icons": "^1.13.14",
    "pinia": "^3",
    "pinia-plugin-persistedstate": "^4",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.4.0",
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-v8": "^4",
    "@vue/compiler-dom": "^3",
    "@vue/test-utils": "^2",
    "eslint": "^9.4.0",
    "eslint-plugin-vue": "^9.26.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.0",
    "knip": "^6.14.1",
    "lint-staged": "^15.2.7",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.77.6",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8",
    "vitest": "^4"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --no-fix"
    ]
  }
}
